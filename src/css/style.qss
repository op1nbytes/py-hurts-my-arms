QMainWindow {
    background-color: #282c34;
    color: #d3d3d3;
}


QTabWidget {
    background-color: #282c34;
    color: #d3d3d3;
}


QTabBar::tab {
    background-color: rgb(36, 36, 36);
    color: #d3d3d3;
    min-width: 10ex;
    min-height: 10ex;
    padding: 10px 20px;
    border-style: none;
}


QTabBar::tab::selected {
    color: #d3d3d3;
    border-style: none;
    background-color: #2d2d2d;
    border-bottom: 2px solid #d3d3d3;
}


QTabBar::close-button {
    image: url(":/icons/close-icon.svg");
}
QTreeView {
    background: transparent;
    color:white;
}

QSplitter {
    background-color: #282c34;
}

QSplitter::handle {
    background-color: #2d2d2d;
}


QScrollBar:vertical {
    border: none;
    width: 14px;
    margin: 15px 0 15px 0;
    background-color: #2d2d2d;
    border-radius: 0px;
}


QScrollBar:handle:vertical {
    background-color: #3e3d3d;
}

QScrollBar:handle:vertical:hover {
    background-color: #4c4a4a;
}


QScrollBar:handle:vertical:pressed {
    background-color: #5c5b5b;
}


QScrollBar::sub-line::vertical {
    border: none;
    background: none;
    height: 15px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line::vertical {
    border: none;
    background: none;
    height: 15px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}


QScrollBar::add-page:vertical,  QScrollBar::sub-page:vertical {
    background: none;
}


QScrollBar:horizontal {
    border: none;
    height: 14px;
    margin: 0px 0 0 0;
    background-color: #2d2d2d;
    border-radius: 0px;
}


QScrollBar:handle:horizontal {
    background-color: #3e3d3d;
}

QScrollBar:handle:horizontal:hover {
    background-color: #4c4a4a;
}

QScrollBar:handle:horizontal:pressed {
    background-color: #5c5b5b;
}


QScrollBar::sub-line::horizontal {
    border: none;
    background: none;
    width: 15px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line::horizontal {
    border: none;
    background: none;
    width: 15px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}


QScrollBar::add-page:horizontal,  QScrollBar::sub-page:horizontal {
    background: none;
}


QsciScintilla { 
    border: none;
    background-color: #282c34;
    color: #D3D3D3;
}


QMessageBox {
    color: white;
    border-radius: 30px;
}

QLineEdit { 
    background-color: #21252b;
    border-radius: 4px;
    border: 1px solid #d3d3d3;
    padding: 3px;
    color: #D3D3D3;
    min-height: 6ex;
}

QLineEditBox:hover {
    color: white;
}

QListView {
    background-color: #21252b;
    border-radius: 5px;
    border: 1px solid #D3D3D3;
    padding: 5px;
    color: #d3d3d3;
}
QListView::item:hover {
    background-color: #323842;
    border: 1px soid #d3d3d3;
    border-radius: 3px;
    color: #d3d3d3;
}

QListView::item:selected {
    background-color: #323842;
    border-style: none;
    color: #D3D3D3;
}

QMenuBar {
    background-color: #282c34;
    border: 1px soid #21252b;
    padding: 3px;
    color: #D3D3D3;
    font-size: 15px;
}

QMenuBar::item {
    background-color: #282c34;
    padding: 3px;
    color: #d3d3d3;
}

QStatusBar#status_bar {
    color: #d3d3d3;
    background-color: #1b1e24;
}

QFrame#side_bar {
    background-color: #1f232a;
}

QLabel#side_bar_icon {
    padding: 6px;
}

QLabel#side_bar_text {
    color: #d3d3d3;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
}

QFrame[role="side-panel"] {
    background-color: #21252b;
    border-radius: 5px;
    border: none;
    padding: 5px;
    color: #d3d3d3;
}

QCheckBox#search_checkbox {
    color: #d3d3d3;
    margin-bottom: 10px;
}

QListWidget#search_list,
QListWidget#snippets_list,
QListWidget#templates_list,
QListWidget#problems_list,
QListWidget#history_list {
    background-color: #1e1e1e;
    border-radius: 5px;
    border: 1px solid #3a3f4b;
    padding: 6px;
    color: #d3d3d3;
}

QListWidget#plugins_list {
    background-color: #1e1e1e;
    border-radius: 5px;
    border: 1px solid #3a3f4b;
    padding: 6px;
    color: #d3d3d3;
}

QListWidget#run_history_list {
    background-color: #1e1e1e;
    border-radius: 5px;
    border: 1px solid #3a3f4b;
    padding: 6px;
    color: #d3d3d3;
}

QPlainTextEdit#run_history_detail,
QPlainTextEdit#run_history_diff {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3a3f4b;
}

QTextEdit#run_history_dna {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3a3f4b;
}

QLabel#run_history_status {
    color: #d3d3d3;
}

QTabWidget#history_tabs::pane {
    border: none;
    background-color: #1e1e1e;
}

QTabWidget#history_tabs QTabBar::tab {
    background-color: #252526;
    color: #d4d4d4;
    padding: 6px 12px;
}

QTabWidget#history_tabs QTabBar::tab:selected {
    background-color: #1e1e1e;
}

QPlainTextEdit#snippet_editor,
QPlainTextEdit#template_preview {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3a3f4b;
}

QLabel#snippet_indent,
QLabel#debug_status {
    color: #d3d3d3;
}

QPushButton {
    background-color: #2d2f34;
    color: #d4d4d4;
    border: 1px solid #3a3f4b;
    padding: 6px 8px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #3a3f4b;
}

QPushButton#panel_button {
    background-color: #2d2f34;
    color: #d4d4d4;
    border: 1px solid #3a3f4b;
    padding: 6px 8px;
    border-radius: 6px;
}

QPushButton#panel_button:hover {
    background-color: #3a3f4b;
}

QPushButton#sidebar_plugin_button {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3a3f4b;
    padding: 0px;
    border-radius: 4px;
}

QPushButton#sidebar_plugin_button:hover {
    background-color: #2d2f34;
}

QTabWidget#bottom_tabs::pane {
    border: none;
    background-color: #1e1e1e;
}

QTabWidget#bottom_tabs QTabBar::tab {
    background-color: #252526;
    color: #d4d4d4;
    padding: 6px 12px;
}

QTabWidget#bottom_tabs QTabBar::tab:selected {
    background-color: #1e1e1e;
}

QDockWidget#bottom_dock {
    background-color: #1e1e1e;
}

QWidget#terminal_header {
    background-color: #1e1e1e;
}

QTextEdit#terminal_output,
QAbstractScrollArea#terminal_output {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    padding: 8px;
    font-family: Consolas, "Cascadia Mono", "Fira Code", monospace;
}
